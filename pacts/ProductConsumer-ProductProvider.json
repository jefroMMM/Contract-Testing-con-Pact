{
  "consumer": {
    "name": "ProductConsumer"
  },
  "interactions": [
    {
      "description": "consultar el producto p-100",
      "providerStates": [
        {
          "name": "existe el producto p-100"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/products/p-100"
      },
      "response": {
        "body": {
          "available": true,
          "id": "p-100",
          "name": "Teclado mecanico",
          "price": 249.9
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.available": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "consultar el producto p-404",
      "providerStates": [
        {
          "name": "no existe el producto p-404"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/products/p-404"
      },
      "response": {
        "body": {
          "error": {
            "code": "PRODUCT_NOT_FOUND",
            "message": "El producto p-404 no existe"
          }
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.error.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "ProductProvider"
  }
}